// PaySwap — Production Prisma Schema
// SQLite-ready (uses compatible types, normalized, indexed, soft-deletes, audit fields)
// NOTE: SQLite does not support BigInt/Decimal/Json — all JSON is stored as String,
// and all timestamps-as-integers are stored as Int.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// AUTH & USERS
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  passwordHash    String?
  name            String?
  phone           String?
  avatarUrl       String?
  status          String      @default("PENDING") // PENDING, ACTIVE, SUSPENDED, FROZEN
  emailVerified   DateTime?
  lastLoginAt     DateTime?
  lastLoginIp     String?
  mfaEnabled      Boolean     @default(false)
  mfaSecret       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  roles           UserRole[]
  accounts        Account[]
  sessions        Session[]
  auditLogs       AuditLog[]
  teamMemberships TeamMember[]

  // Extension marketplace (added in task 2-prisma-fix)
  extensions         Extension[]
  extensionReviews   ExtensionReview[]
  // Organization memberships (added in task 2-prisma-fix)
  orgMemberships     OrganizationMember[]

  @@index([status])
}

model UserRole {
  id          String   @id @default(cuid())
  userId      String
  role        String   // CUSTOMER, MERCHANT, MERCHANT_STAFF, LP, TREASURY, COMPLIANCE, SUPPORT, DEVELOPER, OPERATIONS, ADMIN, SUPER_ADMIN
  merchantId  String?  // if MERCHANT or MERCHANT_STAFF
  permissions String?  // JSON string of granular permissions
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, merchantId])
  @@index([merchantId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model WaitlistEntry {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  company      String?
  phone        String?
  country      String
  businessType String?  // INDIVIDUAL, SMALL_BUSINESS, ENTERPRISE, STARTUP, NGO
  accountType  String?  // MERCHANT, LP, DEVELOPER, CUSTOMER, OTHER
  useCase      String?  // free-text "what do you want to use PaySwap for?"
  monthlyVolume String? // <10K, 10K-100K, 100K-1M, >1M
  referralSource String? // how did you hear about us
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED, CONVERTED
  notes        String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([country])
  @@index([accountType])
}

// ═══════════════════════════════════════════════════════════════════════════
// ACCOUNTS & MERCHANTS
// ═══════════════════════════════════════════════════════════════════════════

model Account {
  id        String   @id @default(cuid())
  userId    String
  type      String   // CUSTOMER, MERCHANT, LP
  status    String   @default("PENDING") // PENDING, ACTIVE, SUSPENDED, CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user      User       @relation(fields: [userId], references: [id])
  merchant  Merchant?
  customer  Customer?
  lpProfile LPProfile?
  wallets   Wallet[]

  @@index([userId])
  @@index([type, status])
}

model Merchant {
  id                  String   @id @default(cuid())
  accountId           String   @unique
  name                String
  legalName           String?
  email               String   @unique
  phone               String?
  country             String
  currency            String   @default("GHS")
  website             String?
  logoUrl             String?
  description         String?
  businessType        String?
  registrationNumber  String?
  taxId               String?
  address             String?  // JSON string
  tier                String   @default("UNVERIFIED") // UNVERIFIED, VERIFIED, TRUSTED, PREMIUM
  bond                Float    @default(0)
  status              String   @default("PENDING") // PENDING, VERIFIED, ACTIVE, SUSPENDED, CLOSED
  kycLevel            Int      @default(0)
  settings            String?  // JSON string
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  account            Account           @relation(fields: [accountId], references: [id])
  products           Product[]
  customers          CustomerRecord[]
  invoices           Invoice[]
  payouts            Payout[]
  refunds            Refund[]
  subscriptions      Subscription[]
  paymentLinks       PaymentLink[]
  apiKeys            ApiKey[]
  webhookEndpoints   WebhookEndpoint[]
  teamMembers        TeamMember[]
  payments           Payment[]

  // Extension marketplace installs (added in task 2-prisma-fix)
  extensionInstalls  ExtensionInstall[]

  @@index([status])
  @@index([tier])
  @@index([country])
}

model Customer {
  id              String   @id @default(cuid())
  accountId       String?  @unique
  name            String
  email           String
  phone           String?
  country         String?
  metadata        String?  // JSON
  totalSpent      Float    @default(0)
  transactionCount Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  account    Account?         @relation(fields: [accountId], references: [id])
  payments   Payment[]
  invoices   Invoice[]
  records    CustomerRecord[]

  @@index([email])
}

model CustomerRecord {
  id              String   @id @default(cuid())
  merchantId      String
  customerId      String?
  name            String
  email           String
  phone           String?
  country         String?
  metadata        String?  // JSON
  totalSpent      Float    @default(0)
  transactionCount Int     @default(0)
  environment     String   @default("sandbox")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  merchant  Merchant @relation(fields: [merchantId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])

  @@index([merchantId])
  @@index([email])
  @@index([environment])
}

model LPProfile {
  id                 String   @id @default(cuid())
  accountId          String   @unique
  name               String
  country            String
  currencies         String   // JSON array
  tier               String   @default("verified")
  stake              Float    @default(0)
  collateral         Float    @default(0)
  capacity           String?  // JSON
  feeBps             String?  // JSON map of corridor → bps (e.g. {"GHS→KES": 50})
  settlementSpeedMs  Int      @default(30000)
  reputation         Float    @default(0.5)
  status             String   @default("pending")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════
// WALLETS
// ═══════════════════════════════════════════════════════════════════════════

model Wallet {
  id              String   @id @default(cuid())
  accountId       String
  name            String
  currency        String
  balance         Float    @default(0)
  pendingBalance  Float    @default(0)
  lockedBalance   Float    @default(0)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account     Account           @relation(fields: [accountId], references: [id])
  transactions WalletTransaction[]

  @@index([accountId])
  @@unique([accountId, currency])
}

model WalletTransaction {
  id           String   @id @default(cuid())
  walletId     String
  type         String   // CREDIT, DEBIT, LOCK, UNLOCK
  amount       Float
  currency     String
  counterparty String?
  reference    String?
  txHash       String?
  createdAt    DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// PAYMENTS & PAYOUTS
// ═══════════════════════════════════════════════════════════════════════════

model Payment {
  id                  String   @id @default(cuid())
  merchantId          String
  customerId          String?
  amount              Float
  currency            String
  sourceCurrency      String?
  destinationCurrency String?
  status              String   @default("PENDING") // PENDING, PROCESSING, SETTLING, COMPLETED, FAILED, CANCELLED, REFUNDED
  method              String?  // CARD, MOBILE_MONEY, BANK, QR, PAYMENT_LINK, CHECKOUT
  corridor            String?
  lpId                String?
  fee                 Float    @default(0)
  netAmount           Float    @default(0)
  fxRate              Float    @default(1)
  txHash              String?
  evidence            String?  // JSON
  reference           String?
  description         String?
  metadata            String?  // JSON
  failureReason       String?
  environment         String   @default("sandbox") // sandbox | live — isolates test traffic from production data
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  settledAt           DateTime?

  merchant  Merchant @relation(fields: [merchantId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
  refunds   Refund[]

  @@index([merchantId, status])
  @@index([customerId])
  @@index([createdAt])
  @@index([corridor])
  @@index([environment])
}

model Payout {
  id                  String   @id @default(cuid())
  merchantId          String
  method              String   // BANK, MOBILE_MONEY, ONCHAIN
  sourceAmount        Float
  sourceAsset         String
  sourceCurrency      String
  destinationCurrency String
  destination         String?  // JSON
  fxRate              Float    @default(1)
  feeBps              Int      @default(50)
  fee                 Float    @default(0)
  netAmount           Float    @default(0)
  status              String   @default("REQUESTED") // REQUESTED, REVIEWING, PROCESSING, COMPLETED, FAILED, CANCELLED
  txHash              String?
  evidence            String?  // JSON
  reason              String?
  failureReason       String?
  approvedBy          String?
  approvedAt          DateTime?
  environment         String   @default("sandbox")
  createdAt           DateTime @default(now())
  processedAt         DateTime?
  completedAt         DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId, status])
  @@index([createdAt])
  @@index([environment])
}

model Refund {
  id          String   @id @default(cuid())
  merchantId  String
  paymentId   String
  amount      Float
  type        String   // FULL, PARTIAL
  reason      String?
  status      String   @default("PENDING") // PENDING, APPROVED, PROCESSED, REJECTED
  requestedBy String
  approvedBy  String?
  processedAt DateTime?
  environment String   @default("sandbox")
  createdAt   DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])
  payment  Payment  @relation(fields: [paymentId], references: [id])

  @@index([merchantId])
  @@index([paymentId])
  @@index([environment])
}

// ═══════════════════════════════════════════════════════════════════════════
// PRODUCTS, INVOICES, SUBSCRIPTIONS, PAYMENT LINKS
// ═══════════════════════════════════════════════════════════════════════════

model Product {
  id          String   @id @default(cuid())
  merchantId  String
  name        String
  description String?
  price       Float
  currency    String
  type        String   @default("PHYSICAL")
  imageUrl    String?
  metadata    String?  // JSON
  status      String   @default("ACTIVE")
  environment String   @default("sandbox")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId, status])
  @@index([environment])
}

model Invoice {
  id          String   @id @default(cuid())
  merchantId  String
  customerId  String?
  number      String
  items       String   // JSON array
  subtotal    Float
  tax         Float    @default(0)
  total       Float
  currency    String
  status      String   @default("DRAFT") // DRAFT, SENT, PAID, OVERDUE, VOID
  dueDate     DateTime?
  sentAt      DateTime?
  paidAt      DateTime?
  paymentId   String?
  environment String   @default("sandbox")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])

  @@index([merchantId, status])
  @@index([customerId])
  @@index([environment])
}

model Subscription {
  id                  String   @id @default(cuid())
  merchantId          String
  customerId          String?
  planName            String
  amount              Float
  currency            String
  interval            String   // DAILY, WEEKLY, MONTHLY, YEARLY
  status              String   @default("ACTIVE")
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  trialEnd            DateTime?
  canceledAt          DateTime?
  lastPaymentAt       DateTime?
  failedAttempts      Int      @default(0)
  environment         String   @default("sandbox")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId, status])
  @@index([environment])
}

model PaymentLink {
  id              String   @id @default(cuid())
  merchantId      String
  amount          Float
  currency        String
  description     String?
  reference       String?
  status          String   @default("ACTIVE")
  url             String   @unique
  expiresAt       DateTime?
  paymentCount    Int      @default(0)
  totalCollected  Float    @default(0)
  environment     String   @default("sandbox")
  createdAt       DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([environment])
}

// ═══════════════════════════════════════════════════════════════════════════
// API KEYS & WEBHOOKS & TEAM
// ═══════════════════════════════════════════════════════════════════════════

model ApiKey {
  id          String   @id @default(cuid())
  merchantId  String
  label       String
  keyPrefix   String   // psk_live_xxx or psk_test_xxx
  keyHash     String   @unique
  scopes      String   // JSON array
  lastUsedAt  DateTime?
  lastUsedIp  String?
  status      String   @default("ACTIVE")
  expiresAt   DateTime?
  environment String   @default("sandbox")
  createdAt   DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([environment])
}

model WebhookEndpoint {
  id          String   @id @default(cuid())
  merchantId  String
  url         String
  secretHash  String
  events      String   // JSON array
  status      String   @default("ACTIVE")
  environment String   @default("sandbox")
  createdAt   DateTime @default(now())

  merchant    Merchant           @relation(fields: [merchantId], references: [id])
  deliveries  WebhookDelivery[]

  @@index([merchantId])
  @@index([environment])
}

model WebhookDelivery {
  id            String   @id @default(cuid())
  endpointId    String
  eventType     String
  payload       String   // JSON
  signature     String
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  responseStatus Int?
  responseBody  String?
  nextRetryAt   DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([status])
}

model TeamMember {
  id         String   @id @default(cuid())
  merchantId String
  email      String
  role       String   // OWNER, ADMIN, DEVELOPER, ANALYST, VIEWER, SUPPORT
  status     String   @default("PENDING")
  invitedAt  DateTime @default(now())
  joinedAt   DateTime?
  userId     String?

  merchant Merchant @relation(fields: [merchantId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@index([merchantId])
  @@unique([merchantId, email])
}

// ═══════════════════════════════════════════════════════════════════════════
// COMPLIANCE
// ═══════════════════════════════════════════════════════════════════════════

model ComplianceReview {
  id          String   @id @default(cuid())
  entityType  String   // MERCHANT, CUSTOMER, LP
  entityId    String
  type        String   // KYC, KYB, SANCTIONS, PEP, AML, RISK
  status      String   @default("PENDING")
  data        String?  // JSON
  reviewerId  String?
  reviewedAt  DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([status])
}

model AMLAlert {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  alertType   String   // STRUCTURING, VELOCITY, HIGH_RISK_CORRIDOR, PEP, SANCTIONS_HIT
  severity    String   // LOW, MEDIUM, HIGH, CRITICAL
  score       Float
  details     String?  // JSON
  status      String   @default("OPEN")
  assignedTo  String?
  environment String   @default("sandbox")
  createdAt   DateTime @default(now())
  closedAt    DateTime?

  @@index([status])
  @@index([entityId])
  @@index([environment])
}

model SAR {
  id            String   @id @default(cuid())
  caseId        String?
  filedBy       String
  narrative     String
  amount        Float
  entities      String   // JSON array
  regulatoryRef String?
  status        String   @default("DRAFT")
  filedAt       DateTime?
  createdAt     DateTime @default(now())

  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════
// AUDIT LOG
// ═══════════════════════════════════════════════════════════════════════════

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  result       String   // SUCCESS, DENIED, ERROR
  ip           String?
  userAgent    String?
  details      String?  // JSON
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// LEGACY (keep for backward compat with existing simulation engine)
// ═══════════════════════════════════════════════════════════════════════════

model SimulationRun {
  id              String   @id @default(cuid())
  runId           String   @unique
  kernelVersion   String
  scenarioName    String
  scenario        String
  result          String
  resultHash      String
  amount          Float
  currency        String
  priority        String
  buyerCountry    String
  merchantCountry String
  costPercent     Float
  settlementMs    Int
  riskScore       Float
  confidence      Float
  settled         Boolean  @default(false)
  amendments      Int      @default(0)
  failures        Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([buyerCountry, merchantCountry])
  @@index([resultHash])
}

model EventRecord {
  id        String   @id @default(cuid())
  eventId   String   @unique
  type      String
  payload   String
  ts        Int      // SQLite does not support BigInt — store epoch-ms as Int
  frame     Int      @default(0)
  seq       Int      @default(0)
  createdAt DateTime @default(now())

  @@index([type])
  @@index([ts])
  @@index([seq])
}

model LedgerSnapshotRecord {
  id           String   @id @default(cuid())
  snapshotId   String   @unique
  asOfTs       Int      // SQLite does not support BigInt — store epoch-ms as Int
  asOfSeq      Int
  accounts     String
  trialBalance String
  entryCount   Int
  eventCount   Int
  durationMs   Int
  createdAt    DateTime @default(now())

  @@index([asOfTs])
  @@index([asOfSeq])
}

// ═══════════════════════════════════════════════════════════════════════════
// EXTENSION MARKETPLACE (added in task 2-prisma-fix)
// ═══════════════════════════════════════════════════════════════════════════

model Extension {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  description   String
  developerId   String
  category      String    // payments | analytics | compliance | accounting | crm | marketing | shipping | other
  iconUrl       String?
  version       String    @default("1.0.0")
  status        String    @default("draft") // draft | submitted | review | approved | published | rejected | suspended
  permissions   String    // JSON array: read_payments | write_payments | read_customers | write_customers | send_webhooks
  pricing       String    @default("free") // free | paid | freemium
  price         Float     @default(0)
  config        String?   // JSON schema object for merchant config
  changelog     String?   // JSON array of { version, date, changes }
  installCount  Int       @default(0)
  rating        Float     @default(0)
  reviewCount   Int       @default(0)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewedBy    String?   // userId of admin reviewer
  reviewNotes   String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  developer User               @relation(fields: [developerId], references: [id])
  installs   ExtensionInstall[]
  reviews    ExtensionReview[]

  @@index([status])
  @@index([category])
  @@index([developerId])
}

model ExtensionInstall {
  id          String   @id @default(cuid())
  extensionId String
  merchantId  String
  status      String   @default("active") // active | disabled
  config      String?  // JSON object — merchant-specific config for the extension
  installedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  extension Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  merchant  Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([extensionId, merchantId])
  @@index([merchantId])
  @@index([status])
}

model ExtensionReview {
  id          String   @id @default(cuid())
  extensionId String
  userId      String
  rating      Int
  comment     String
  createdAt   DateTime @default(now())

  extension Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // NOTE: No @@unique([extensionId, userId]) — the seed script creates multiple
  // reviews per extension by the same developer user, so we allow it.
  @@index([extensionId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// SIMULATOR PERSISTENCE (added in task 2-prisma-fix)
// ═══════════════════════════════════════════════════════════════════════════

model SavedScenarioRecord {
  id             String   @id @default(cuid())
  scenarioId     String   @unique
  name           String
  description    String?
  category       String?
  scenario       String   // JSON-serialized SimulationScenario
  baselineHash   String?
  baselineCost   Float    @default(0)
  baselineTime   Int      @default(0)
  baselineRisk   Float    @default(0)
  baselineConf   Float    @default(0)
  lastRunAt      DateTime?
  lastRunPassed  Boolean?
  createdAt      DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

model LedgerEntryRecord {
  id            String   @id @default(cuid())
  runId         String
  txId          String?
  accountId     String?
  accountLabel  String?
  accountType   String?
  currency      String?
  debit         Float    @default(0)
  credit        Float    @default(0)
  balanceAfter  Float    @default(0)
  memo          String?
  frame         Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([runId])
  @@index([accountId])
}

model TwinTokenRecord {
  id             String   @id @default(cuid())
  runId          String
  symbol         String?
  amount         Float    @default(0)
  currency       String?
  fromCountry    String?
  toCountry      String?
  status         String?
  mintedAtFrame  Int?
  burnedAtFrame  Int?
  memo           String?
  createdAt      DateTime @default(now())

  @@index([runId])
}

model PlanAmendmentRecord {
  id               String   @id @default(cuid())
  runId            String
  failureType      String?
  failureLabel     String?
  reason           String?
  recoveryStrategy String?
  insertedAtFrame  Int      @default(0)
  stepCount        Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([runId])
}

model CheckpointRecord {
  id             String   @id @default(cuid())
  name           String   @unique
  lastSeq        Int      @default(0)
  lastTs         Int      // SQLite does not support BigInt — store epoch-ms as Int
  lastSnapshotId String?
  totalCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════
// OPS INCIDENTS (added in task 2-prisma-fix)
// ═══════════════════════════════════════════════════════════════════════════

model Incident {
  id             String    @id @default(cuid())
  title          String
  description    String?
  severity       String    @default("P2") // P1 | P2 | P3 | P4
  status         String    @default("open") // open | investigating | identified | monitoring | resolved
  component      String?   // api | payments | payouts | webhooks | connectors | blockchain
  createdBy      String?   // userId of creator
  assignedTo     String?   // userId of assignee
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  updates IncidentUpdate[]

  @@index([status])
  @@index([severity])
  @@index([component])
  @@index([createdAt])
}

model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  authorId   String?  // userId of author
  message    String
  status     String?  // investigating | identified | monitoring | resolved
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// ORGANIZATIONS (added in task 2-prisma-fix)
// ═══════════════════════════════════════════════════════════════════════════

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  type         String   @default("merchant") // merchant | lp | platform
  status       String   @default("active") // active | pending | suspended
  billingEmail String?
  country      String?
  currency     String   @default("GHS")
  plan         String   @default("starter") // starter | growth | scale | enterprise
  logoUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members OrganizationMember[]

  @@index([type])
  @@index([status])
}

model OrganizationMember {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  role           String    @default("viewer") // owner | admin | developer | analyst | finance | support | viewer
  status         String    @default("pending") // active | pending | suspended
  invitedAt      DateTime  @default(now())
  joinedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([status])
}
