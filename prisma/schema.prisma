// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// PaySwap Kernel — Global Liquidity OS persistence
// ---------------------------------------------------------------------------

model SimulationRun {
  id              String   @id @default(cuid())
  runId           String   @unique
  kernelVersion   String
  scenarioName    String
  scenario        String   // JSON-encoded SimulationScenario
  result          String   // JSON-encoded SimulationResult
  resultHash      String
  amount          Float
  currency        String
  priority        String
  buyerCountry    String
  merchantCountry String
  costPercent     Float
  settlementMs    Int
  riskScore       Float
  confidence      Float
  settled         Boolean  @default(false)
  amendments      Int      @default(0)
  failures        Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([buyerCountry, merchantCountry])
  @@index([resultHash])
}

model LedgerEntryRecord {
  id            String   @id @default(cuid())
  runId         String
  txId          String
  accountId     String
  accountLabel  String
  accountType   String
  currency      String
  debit         Float    @default(0)
  credit        Float    @default(0)
  balanceAfter  Float
  memo          String
  frame         Int
  ts            DateTime @default(now())

  @@index([runId])
  @@index([accountId])
}

model TwinTokenRecord {
  id            String   @id @default(cuid())
  runId         String
  symbol        String
  amount        Float
  currency      String
  fromCountry   String
  toCountry     String
  status        String
  mintedAtFrame Int
  burnedAtFrame Int?
  memo          String
  createdAt     DateTime @default(now())

  @@index([runId])
  @@index([symbol])
}

model PlanAmendmentRecord {
  id              String   @id @default(cuid())
  runId           String
  failureType     String
  failureLabel    String
  reason          String
  recoveryStrategy String
  insertedAtFrame Int
  stepCount       Int
  createdAt       DateTime @default(now())

  @@index([runId])
}

model AuditLog {
  id        String   @id @default(cuid())
  runId     String
  actor     String
  action    String
  detail    String
  ts        DateTime @default(now())

  @@index([runId])
  @@index([action])
}

model SavedScenarioRecord {
  id              String   @id @default(cuid())
  scenarioId      String   @unique
  name            String
  description     String
  category        String
  scenario        String   // JSON-encoded SimulationScenario
  baselineHash    String
  baselineCost    Float
  baselineTime    Int
  baselineRisk    Float
  baselineConf    Float
  lastRunAt       DateTime?
  lastRunPassed   Boolean?
  createdAt       DateTime @default(now())

  @@index([category])
  @@index([name])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
