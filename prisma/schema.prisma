// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// PaySwap Kernel — Global Liquidity OS persistence
// ---------------------------------------------------------------------------

model SimulationRun {
  id              String   @id @default(cuid())
  runId           String   @unique
  kernelVersion   String
  scenarioName    String
  scenario        String   // JSON-encoded SimulationScenario
  result          String   // JSON-encoded SimulationResult
  resultHash      String
  amount          Float
  currency        String
  priority        String
  buyerCountry    String
  merchantCountry String
  costPercent     Float
  settlementMs    Int
  riskScore       Float
  confidence      Float
  settled         Boolean  @default(false)
  amendments      Int      @default(0)
  failures        Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([buyerCountry, merchantCountry])
  @@index([resultHash])
}

model LedgerEntryRecord {
  id            String   @id @default(cuid())
  runId         String
  txId          String
  accountId     String
  accountLabel  String
  accountType   String
  currency      String
  debit         Float    @default(0)
  credit        Float    @default(0)
  balanceAfter  Float
  memo          String
  frame         Int
  ts            DateTime @default(now())

  @@index([runId])
  @@index([accountId])
}

model TwinTokenRecord {
  id            String   @id @default(cuid())
  runId         String
  symbol        String
  amount        Float
  currency      String
  fromCountry   String
  toCountry     String
  status        String
  mintedAtFrame Int
  burnedAtFrame Int?
  memo          String
  createdAt     DateTime @default(now())

  @@index([runId])
  @@index([symbol])
}

model PlanAmendmentRecord {
  id              String   @id @default(cuid())
  runId           String
  failureType     String
  failureLabel    String
  reason          String
  recoveryStrategy String
  insertedAtFrame Int
  stepCount       Int
  createdAt       DateTime @default(now())

  @@index([runId])
}

model AuditLog {
  id        String   @id @default(cuid())
  runId     String
  actor     String
  action    String
  detail    String
  ts        DateTime @default(now())

  @@index([runId])
  @@index([action])
}

model SavedScenarioRecord {
  id              String   @id @default(cuid())
  scenarioId      String   @unique
  name            String
  description     String
  category        String
  scenario        String   // JSON-encoded SimulationScenario
  baselineHash    String
  baselineCost    Float
  baselineTime    Int
  baselineRisk    Float
  baselineConf    Float
  lastRunAt       DateTime?
  lastRunPassed   Boolean?
  createdAt       DateTime @default(now())

  @@index([category])
  @@index([name])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// PaySwap PRODUCTION-3+ — Persistent Event Store + Snapshots
//
// The event stream is the single source of truth. Every state change emits
// an event that is appended here. On restart, the entire protocol state is
// rebuilt by replaying the event stream (fast-forwarded via snapshots).
//
// Snapshots are point-in-time ledger states taken periodically so projection
// rebuilds are O(post-snapshot events) instead of O(all events).
// ---------------------------------------------------------------------------

model EventRecord {
  id        String   @id @default(cuid())
  eventId   String   @unique
  type      String
  payload   String   // JSON-encoded
  ts        BigInt
  frame     Int      @default(0)
  seq       Int      @default(0)  // monotonic sequence for strict ordering
  createdAt DateTime @default(now())

  @@index([type])
  @@index([ts])
  @@index([seq])
}

model LedgerSnapshotRecord {
  id           String   @id @default(cuid())
  snapshotId   String   @unique
  asOfTs       BigInt
  asOfSeq      Int      // last event seq included in this snapshot
  accounts     String   // JSON-encoded Record<accountCode, {debit, credit, balance}>
  trialBalance String   // JSON-encoded {totalDebits, totalCredits, balanced}
  entryCount   Int
  eventCount   Int      // events replayed to produce this snapshot
  durationMs   Int
  createdAt    DateTime @default(now())

  @@index([asOfTs])
  @@index([asOfSeq])
}

model CheckpointRecord {
  id              String   @id @default(cuid())
  name            String   @unique  // e.g. "event_store", "ledger_snapshot"
  lastSeq         Int      @default(0)
  lastTs          BigInt   @default(0)
  lastSnapshotId  String?
  totalCount      Int      @default(0)
  updatedAt       DateTime @updatedAt
}
